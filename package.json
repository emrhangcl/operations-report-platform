{
  "name": "operations-portal",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "pnpm --filter @operations/admin dev",
    "dev:mobile": "pnpm --filter @operations/mobile start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "design:check": "node scripts/impeccable-design-check.mjs",
    "test": "pnpm -r --if-present test && pnpm test:scripts",
    "test:scripts": "vitest run --dir scripts",
    "build": "pnpm --filter @operations/admin build && pnpm --filter @operations/mobile typecheck",
    "create-admin": "tsx --conditions=react-server scripts/create-admin.ts",
    "db:init": "node scripts/local/postgres.mjs init && tsx scripts/db/migrate.ts && tsx scripts/db/migrate.ts --test",
    "db:start": "node scripts/local/postgres.mjs start",
    "db:stop": "node scripts/local/postgres.mjs stop",
    "db:restart": "node scripts/local/postgres.mjs restart",
    "db:status": "node scripts/local/postgres.mjs status",
    "db:psql": "node scripts/local/postgres.mjs psql",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:reset": "tsx scripts/db/migrate.ts --reset",
    "setup:local": "node scripts/local/setup.mjs",
    "db:test": "tsx scripts/db/test.ts",
    "test:e2e": "tsx scripts/e2e/local-stack.ts",
    "storage:encrypt": "tsx --conditions=react-server scripts/storage/encrypt-existing.ts",
    "backup": "tsx scripts/backup/backup.ts create",
    "backup:list": "tsx scripts/backup/backup.ts list",
    "backup:verify": "tsx scripts/backup/backup.ts verify",
    "backup:schedule": "node scripts/backup/schedule.mjs install",
    "backup:unschedule": "node scripts/backup/schedule.mjs remove"
  },
  "devDependencies": {
    "@operations/data-client": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
