{
  "expo": {
    "name": "TUNCA Rapor",
    "slug": "tunca-rapor",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/tunca-app-icon.png",
    "scheme": "tunca-rapor",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tunca.rapor"
    },
    "android": {
      "package": "com.tunca.rapor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tunca-app-icon.png",
        "backgroundColor": "#f2f3f5"
      }
    },
    "splash": {
      "image": "./assets/tunca-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2f3f5"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Rapor fotoğrafları eklemek için galeri erişimi gerekir.",
          "cameraPermission": "Rapor fotoğrafları çekmek için kamera erişimi gerekir."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
