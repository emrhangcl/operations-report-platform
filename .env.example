# Yerel kurulumda `pnpm setup:local` bu dosyadaki bos degerleri otomatik doldurur.
# Gercek .env dosyasini asla Git'e eklemeyin. Asagidaki degerlerin tamami sunucu tarafindadir;
# tarayici veya mobil paketlere hicbir sir tasinmaz.

# --- Uygulama ---------------------------------------------------------------

# Runtime ortami: development, staging veya production.
APP_ENV=development

# Kanonik web adresi. E-posta baglantilari, CSRF kaynak kontrolu ve cerez guvenligi icin kullanilir.
# https:// ile baslarsa oturum cerezleri `__Host-` onekli ve Secure olarak ayarlanir.
APP_URL=http://localhost:3000

# Imzali dosya baglantilari icin en az 32 karakterlik rastgele anahtar.
AUTH_SECRET=

# Giris icin e-posta dogrulamasi zorunlu olsun mu? Dogrulama e-postalari OPS_DATA_DIR/mail-outbox
# klasorune .eml dosyasi olarak yazilir.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Istege bagli oturum ve giris korumasi ayarlari (varsayilanlar gosterilmistir).
# AUTH_ADMIN_SESSION_TTL_HOURS=168
# AUTH_ADMIN_SESSION_IDLE_HOURS=24
# AUTH_PERSONNEL_SESSION_TTL_HOURS=720
# AUTH_PERSONNEL_SESSION_IDLE_HOURS=168
# AUTH_MAX_FAILED_LOGINS=8
# AUTH_LOCK_MINUTES=15
# Ayni IP adresinden bu pencere icinde bu kadar basarisiz giris olursa adres engellenir.
# AUTH_IP_MAX_FAILURES=20
# AUTH_IP_BLOCK_MINUTES=15
# DATA_MAX_ROWS=1000
# MAIL_FROM="Operasyon Portali <no-reply@localhost>"

# Istemci IP adresi `server.mjs` tarafindan soket adresinden belirlenir; istemcinin gonderdigi
# X-Forwarded-For yok sayilir. Uygulama bir ters proxy (nginx, Caddy) arkasindaysa proxy'nin
# adresini buraya yazin; yalnizca bu adreslerden gelen X-Forwarded-For zinciri dikkate alinir.
# TRUST_PROXY_IPS=127.0.0.1,::1

# --- Veri sifreleme ve yedekleme ---------------------------------------------

# Yuklenen dosyalarin diskte AES-256-GCM ile sifrelenmesi icin 32 baytlik base64url anahtar.
# Zorunludur; eksikse uygulama baslamaz. Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Anahtari kaybetmek tum dosyalari kaybetmek demektir: .env disinda guvenli bir yerde de saklayin.
STORAGE_ENCRYPTION_KEY=
# Anahtar degistirilirken eski anahtarlar (virgulle) burada tutulur; eski dosyalar okunmaya devam
# eder. `pnpm storage:encrypt --rotate` tum dosyalari yeni anahtarla yeniden sifreler.
# STORAGE_ENCRYPTION_PREVIOUS_KEYS=

# Yedeklerin sifrelenmesi icin ayri bir 32 baytlik base64url anahtar (STORAGE anahtarindan farkli).
# Yedek bu anahtar olmadan geri yuklenemez; .env ve yedeklerden ayri bir yerde saklayin.
BACKUP_ENCRYPTION_KEY=
# Yedek klasoru (varsayilan OPS_DATA_DIR/backups), saklanacak yedek sayisi ve istege bagli ikinci
# kopya konumu (or. harici disk veya ag klasoru).
# BACKUP_DIR=
# BACKUP_RETENTION=14
# BACKUP_COPY_DIR=
# Gunluk zamanlanmis yedegin saati (pnpm backup:schedule).
# BACKUP_TIME=02:00

# --- Veritabani (PostgreSQL 18) ---------------------------------------------

# Uygulama baglantisi: `ops_app` rolu. Kendi basina tablo yetkisi yoktur; her istekte RLS'e tabi
# `authenticated` / `anon` rolune ya da dogrulanmis server islemleri icin `service_role`'e gecer.
DATABASE_URL=
# Migration baglantisi: sema sahibi `ops_owner`. Uygulama calisirken kullanilmaz.
DATABASE_MIGRATION_URL=
# Testler icin ayri veritabani (pnpm db:test her calistirmada sifirlar).
TEST_DATABASE_URL=
TEST_DATABASE_MIGRATION_URL=

# Veri klasoru: PostgreSQL verisi, yuklenen dosyalar, giden e-postalar ve yedekler.
# Varsayilan Windows'ta %USERPROFILE%\OperationsPortal, Linux/macOS'ta ~/.local/share/operations-portal.
# OPS_DATA_DIR=
# PostgreSQL binary klasoru. Varsayilan Windows'ta %LOCALAPPDATA%\Programs\PostgreSQL\18\bin.
# PG_BIN_DIR=
# OPS_PG_PORT=5432

# --- Mobil (Expo) -----------------------------------------------------------

# apps/mobile/.env icine yazilir. Telefonun bilgisayara ulasacagi adres, or. http://192.168.1.20:3000
# EXPO_PUBLIC_API_URL=

# --- Odeme saglayicisi --------------------------------------------------------

# Aylik/yillik abonelik saglayicisi. Gercek entegrasyon secim ve sandbox anahtari sonrasi acilir.
PAYMENT_PROVIDER=

# Saglayiciya gore yalnizca server tarafinda kullanilacak gizli degerler.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# --- Uctan uca test hesaplari (yalnizca yerel) ---------------------------------

# `pnpm test:e2e` bu hesaplari kullanir. Platform sahibi `pnpm create-admin --platform` ile,
# firma yoneticisi /register ile, personel ise firma panelinden olusturulur.
# E2E_PLATFORM_EMAIL=
# E2E_PLATFORM_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_PERSONNEL_EMAIL=
# E2E_PERSONNEL_PASSWORD=
