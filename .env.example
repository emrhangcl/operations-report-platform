# Runtime ortami: development, staging veya production.
APP_ENV=

# E-posta donusleri ve guvenli mutlak URL uretimi icin kanonik web adresi.
APP_URL=

# Web istemcisinin kullanacagi public Supabase ayarlari.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yalnizca Expo istemcisi icin public Supabase ayarlari.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Yalnizca server ve yonetim scriptleri kullanir. Client tarafina tasimayin.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel disinda bos birakin. Vercel deployment'inda gerekirse true yapin.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=

# Aylik/yillik abonelik saglayicisi. Gercek entegrasyon secim ve sandbox anahtari sonrasi acilir.
PAYMENT_PROVIDER=

# Saglayiciya gore yalnizca server tarafinda kullanilacak gizli degerler.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
