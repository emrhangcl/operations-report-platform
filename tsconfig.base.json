{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@tunca/types": ["packages/types/src/index.ts"],
      "@tunca/validation": ["packages/validation/src/index.ts"],
      "@tunca/shared": ["packages/shared/src/index.ts"],
      "@tunca/payments": ["packages/payments/src/index.ts"]
    }
  }
}
